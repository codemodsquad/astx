{
  "name": "astx",
  "version": "0.0.0-development",
  "description": "super powerful structural search and replace for JavaScript and TypeScript to automate your refactoring",
  "astx": {
    "parser": "babel",
    "workers": 1,
    "parserOptions": {
      "preserveFormat": "generatorHack"
    },
    "preferSimpleReplacement": true
  },
  "sideEffects": false,
  "scripts": {
    "cli": "babel-node --extensions .ts src/cli/index.ts",
    "tc": "toolchain",
    "toolchain": "toolchain",
    "test": "toolchain test",
    "prepublishOnly": "echo This package is meant to be published by semantic-release from the dist build directory. && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codemodsquad/astx.git"
  },
  "keywords": [
    "ast",
    "automated",
    "codemod",
    "find",
    "javascript",
    "match",
    "matching",
    "pattern",
    "refactor",
    "refactoring",
    "replace",
    "rewrite",
    "rewriting",
    "search",
    "semantic",
    "structural",
    "syntax",
    "transform",
    "transformation",
    "typescript"
  ],
  "author": "Andy Edwards",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/codemodsquad/astx/issues"
  },
  "homepage": "https://github.com/codemodsquad/astx#readme",
  "devDependencies": {
    "@babel/node": "^7.29.7",
    "@jcoreio/toolchain": "^6.0.9",
    "@jcoreio/toolchain-circle": "^6.0.9",
    "@jcoreio/toolchain-esnext": "^6.0.9",
    "@jcoreio/toolchain-mocha": "^6.0.9",
    "@jcoreio/toolchain-semantic-release": "^6.0.9",
    "@jcoreio/toolchain-typescript": "^6.0.9",
    "@types/babel__code-frame": "^7.27.0",
    "@types/babel__generator": "^7.27.0",
    "@types/chai": "^4.3.5",
    "@types/chai-as-promised": "^7.1.5",
    "@types/chai-subset": "^1.3.3",
    "@types/debug": "^4.1.5",
    "@types/diff": "^5.0.9",
    "@types/fs-extra": "^9.0.6",
    "@types/glob": "^8.0.0",
    "@types/inquirer": "^7.3.1",
    "@types/lodash": "^4.14.165",
    "@types/minimatch": "^5.1.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "^14.18.26",
    "@types/prettier": "^2.2.2",
    "@types/resolve": "^1.17.1",
    "@types/shallowequal": "^1.1.1",
    "@types/yargs": "^17.0.13",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^7.2.0",
    "globals": "^16.0.0",
    "lint-staged": "^15.2.2",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.4.2",
    "require-glob": "^3.2.0",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "@babel/generator": "^7.29.15",
    "@babel/parser": "^7.29.15",
    "@babel/register": "^7.29.13",
    "@babel/runtime": "^7.29.15",
    "@babel/types": "^7.29.15",
    "ansi-escapes": "^4.3.2",
    "ast-types": "^0.14.2",
    "babel-parse-wild-code": "^2.1.5",
    "chalk": "^4.1.0",
    "cosmiconfig": "^7.0.1",
    "debug": "^4.3.1",
    "dedent-js": "^1.0.1",
    "diff": "^5.2.0",
    "fs-extra": "^9.0.1",
    "gitignore-fs": "^2.2.0",
    "inquirer": "^7.3.3",
    "lodash": "^4.17.20",
    "minimatch": "^5.1.0",
    "p-event": "^4.0.0",
    "prettier": "^2.7.1",
    "recast": "^0.23.4",
    "resolve": "^1.19.0",
    "shallowequal": "^1.1.0",
    "tiny-typed-emitter": "^2.1.0",
    "tsx": "^4.19.3",
    "yargs": "^17.6.2",
    "zod": "^3.22.4"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "astx": "./dist/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": {
        "import": "./dist/index.d.mts",
        "default": "./dist/index.d.ts"
      }
    },
    "./node": {
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js",
      "types": {
        "import": "./dist/node/index.d.mts",
        "default": "./dist/node/index.d.ts"
      }
    },
    "./cli": {
      "import": "./dist/cli/index.mjs",
      "require": "./dist/cli/index.js",
      "types": {
        "import": "./dist/cli/index.d.mts",
        "default": "./dist/cli/index.d.ts"
      }
    }
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.6.5",
  "@jcoreio/toolchain": {
    "migratedVersion": "6.0.9"
  }
}
